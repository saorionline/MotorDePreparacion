{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "01 · ESTACIÓN 4 · REPRESENTACIÓN — Suma máxima por contrato y cuántos casos exceden 2^53-1. Declarativa, no programada. Lee datos/respuestas.csv.",
  "data": { "url": "datos/respuestas.csv" },
  "title": "Suma de arreglo: dos contratos, una solución",
  "vconcat": [
    {
      "mark": "bar",
      "encoding": {
        "x": { "field": "contrato", "type": "nominal", "title": "contrato" },
        "y": {
          "field": "suma_maxima",
          "type": "quantitative",
          "scale": { "type": "log" },
          "title": "suma máxima (escala log)"
        },
        "color": { "field": "contrato", "type": "nominal", "legend": null },
        "tooltip": [
          { "field": "contrato" },
          { "field": "casos" },
          { "field": "suma_maxima" },
          { "field": "casos_que_exceden_2_53" }
        ]
      }
    },
    {
      "mark": { "type": "bar", "color": "#b91c1c" },
      "encoding": {
        "x": { "field": "contrato", "type": "nominal", "title": "contrato" },
        "y": {
          "field": "casos_que_exceden_2_53",
          "type": "quantitative",
          "title": "casos que exceden 2⁵³−1"
        },
        "tooltip": [{ "field": "contrato" }, { "field": "casos_que_exceden_2_53" }]
      }
    }
  ]
}
